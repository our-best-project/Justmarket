{
  "name": "justmarket-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build",
    "build:pages:relative": "cross-env BASE_PATH=./ vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"*.config.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:deps": "madge --circular --extensions ts,tsx src",
    "check:install": "npm ls --all",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:deps && npm run check:install"
  },
  "dependencies": {
    "three": "0.185.0"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "24.1.0",
    "@types/three": "0.185.1",
    "cross-env": "7.0.3",
    "eslint": "9.32.0",
    "globals": "16.3.0",
    "madge": "8.0.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
