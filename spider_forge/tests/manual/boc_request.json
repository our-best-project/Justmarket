      "/press/press-releases/?$",
      "/page/\\d+/?$"
    ],
    "min_content_chars": 40,
    "max_age_days": 365,
    "min_valid_items": 5,
    "min_unique_ratio": 0.8
  },
  "constraints": {
    "source_timezone": "America/Toronto"
  },
  "topic_gate": {
    "mode": "off"
  }
