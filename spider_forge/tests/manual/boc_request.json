{
  "site_url": "https://www.bankofcanada.ca/press/press-releases/",
  "site_name": "加拿大央行新聞稿",
  "source_prefix": "boc_press",
  "target_schema": {
    "source_type": "official",
    "content_scope": "full",
    "fields": {
