# 複製成 .env 後填真值；.env 不進 git。
# 正式資料庫是 Neon（雲端 PostgreSQL），本機不另起應用 DB。

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# API 連線池上限。Neon 有連線數上限，預設保守。
API_DB_POOL_MAX=10
# 端點 TTL 快取秒數。資料每日盤後才更新，TTL 內直接回上次結果、完全不碰 DB。
API_CACHE_TTL_SECONDS=60
# 前端部署在別的網域時要補進 CORS（逗號分隔）。GitHub Pages：
# CORS_EXTRA_ORIGINS=https://our-best-project.github.io
CORS_EXTRA_ORIGINS=

# ── 外部資料源 ──────────────────────────────────────────────────────────
FINMIND_TOKEN=

# LLM 供應商：gemini（AI Studio 金鑰）| openai | vertex（GCP 額度，production 用這個）
# vertex 時 LLM_API_KEY 可留空，但 GCP_PROJECT 必填（無預設，缺了 LLM 段直接報錯）；
# GCP_LOCATION 留 global —— gemini-2.5 系列只在 global 端點，區域端點會 404。
LLM_PROVIDER=gemini
GCP_PROJECT=
GCP_LOCATION=global
LLM_API_KEY=

# ── Spider Forge（AI 爬蟲生成，不在每日管線內）──────────────────────────
SPIDERFORGE_TOPIC_MODEL=gemini-3.5-flash-lite
DEEPSEEK_API=
KIMI_API=
SPIDERFORGE_OLLAMA_HOST=http://host.docker.internal:11434
SPIDERFORGE_JUDGE_MODEL=qwen2.5:7b-instruct

# ── 排程與管線 ──────────────────────────────────────────────────────────
# Prefect metadata 只存在本機 Docker volume，與 Neon 的應用資料分離。
PREFECT_DB_PASSWORD=change-this-local-password

# 正式新聞入口：只允許 crawler/ 裡已核准的 spider。
NEWS_SPIDERS=cnyes,twse_mops_finance
NEWS_PIPELINE_STAGES=all

# GPU worker；沒有 NVIDIA GPU 時改成 auto 或 cpu。
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=32
